Cell["\<\
V tem delu simuliramo vlagatelja, ki naklju\[CHacek]no izbere dan nakupa in \
kasnej\[SHacek]i dan prodaje delnice. Izra\[CHacek]unamo njegov \
dobi\[CHacek]ek oziroma izgubo ter nato simulacijo ve\[CHacek]krat ponovimo.\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10002.},
 CellChangeTimes->{3.992077588051319*^9, 3.9920779268667793`*^9, 
  3.9920975763667774`*^9},ExpressionUUID->"d56860ac-6485-b14e-9640-\
a444bb0c047f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"buy", "=", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{
       RowBox[{"Length", "[", "last", "]"}], "-", "1"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sell", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"buy", "+", "1"}], ",", 
       RowBox[{"Length", "[", "last", "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"buyPrice", "=", 
   RowBox[{"last", "[", 
    RowBox[{"[", "buy", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sellPrice", "=", 
    RowBox[{"last", "[", 
     RowBox[{"[", "sell", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"profit", "=", 
    RowBox[{"sellPrice", "-", "buyPrice"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Nakupni dan\>\"", ",", 
       RowBox[{"dates", "[", 
        RowBox[{"[", "buy", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Prodajni dan\>\"", ",", 
       RowBox[{"dates", "[", 
        RowBox[{"[", "sell", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Nakupna cena\>\"", ",", "buyPrice"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Prodajna cena\>\"", ",", "sellPrice"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Dobi\[CHacek]ek/izguba\>\"", ",", "profit"}], "}"}]}], 
    "}"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10002.},
 CellChangeTimes->{3.9920776161754093`*^9, 3.9920779529106503`*^9, 
  3.992081218981659*^9, 3.992081296933838*^9, 3.9920975763667774`*^9},
 CellLabel->
  "In[534]:=",ExpressionUUID->"b78366ea-c092-5e42-b966-5c72484101f5"],

