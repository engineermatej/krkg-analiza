     RowBox[{"{", 
      RowBox[{"\"\<Proizvodno-distribucijski centri\>\"", 
       ",", "\"\<Rusija, Poljska, Hrva\[SHacek]ka, Nem\[CHacek]ija\>\""}], 
      "}"}]}], "}"}], ",", 
