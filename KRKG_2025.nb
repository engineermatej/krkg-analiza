Cell["\<\
Da dobimo bolj realisti\[CHacek]en vpogled v uspe\[SHacek]nost \
naklju\[CHacek]nega trgovanja, simulacijo ponovimo 1000-krat. Vsaka \
simulacija predstavlja en naklju\[CHacek]en nakup in kasnej\[SHacek]o prodajo \
delnice.\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10002.},
 CellChangeTimes->{3.9920783841177464`*^9, 3.99207877251824*^9, 
  3.9920975763667774`*^9},ExpressionUUID->"fe12febd-0a93-b741-b685-\
02c1f4650c53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RandomTradeProfit", "[", "prices_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"buy", ",", "sell"}], "}"}], ",", 
     RowBox[{
      RowBox[{"buy", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "prices", "]"}], "-", "1"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sell", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"buy", "+", "1"}], ",", 
          RowBox[{"Length", "[", "prices", "]"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
